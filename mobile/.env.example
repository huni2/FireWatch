EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Google Cloud Console에서 발급한 Android OAuth 클라이언트 ID(비밀값 아님, 패키지명+SHA-1로 식별되는
# 공개 식별자) — APP-6. 형식: xxxxx-xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# 서버용 ID 토큰의 대상: Android ID와 별개인 웹 OAuth 공개 ID.
# 기본값은 app.json extra.googleWebClientId. 서버 GOOGLE_OAUTH_CLIENT_IDS에도 포함해야 한다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
